# Copy to .env.local and fill in. Restart the app after changing it.

# --- Plans: OpenCode Go (uses Claude Haiku 5.5) ---
# Key from https://opencode.ai/console
OPENCODE_API_KEY=

# Optional: use OpenCode Zen instead of Go, with a bigger model
# OPENCODE_BASE_URL=https://opencode.ai/inference/anthropic
# FAMILYTRIP_MODEL=claude-opus-5-5

# --- Or plans straight from Anthropic (used only if OPENCODE_API_KEY is empty) ---
# ANTHROPIC_API_KEY=

# With neither key the app runs in demo mode with sample plans.
# FAMILYTRIP_MOCK=1 forces demo mode.

# --- Live checks ---
# Google Maps: photos and opening hours. Enable "Places API (New)" in Google
# Cloud and create a key restricted to it. Leave empty to skip live checks.
GOOGLE_MAPS_API_KEY=

# Real travel times come from Transitous (free, no key). Their usage policy
# asks apps to identify themselves; put an email or URL they can reach you at.
FAMILYTRIP_CONTACT=
